#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
# Thư mục chứa worker; có thể ghi đè bằng ESPFLASH_WORKER_ROOT.
# Mặc định trỏ tới repo trong $HOME thay vì hard-code đường dẫn tuyệt đối.
ROOT="${ESPFLASH_WORKER_ROOT:-$HOME/esp32-toolkit}"
PYTHON="${PYTHON:-$PREFIX/bin/python}"

exec "$PYTHON" -u "$ROOT/usb_worker.py" "$@"
